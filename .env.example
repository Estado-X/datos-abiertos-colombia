# Modo HTTP (datos-abiertos-colombia --http)
MCP_HOST=127.0.0.1
MCP_PORT=8000
LOG_LEVEL=INFO

# Opcional: dominios extra desde los que se permite llamar al servidor HTTP
# si lo alojas tú (separados por coma). Por defecto, solo localhost.
# MCP_HOSTS_PERMITIDOS=mcp.tudominio.gov.co

# Opcional: token de aplicación de Socrata para tener más cupo de consultas.
# Se pide gratis en https://www.datos.gov.co (perfil → Developer settings). No es obligatorio.
# SOCRATA_APP_TOKEN=
